# ── Meta Marketing API (servidor apenas — nunca expor no frontend) ──
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXX
# Restringe o seletor de contas do dashboard a essas (separadas por vírgula),
# ignorando o filtro padrão por account_status ativo — útil quando uma conta
# do negócio está temporariamente pausada (ex.: pagamento pendente) mas ainda
# deve aparecer na lista. Sem essa variável, só contas com status ativo aparecem.
META_ALLOWED_ACCOUNT_IDS=act_328274720105539,act_115097955921855,act_630972797908360,act_1197249103808364

# ── Google Ads API (servidor apenas — nunca expor no frontend) ──
# Credenciais OAuth do projeto Google Cloud "tuzinho-dash" + refresh token gerado
# no OAuth Playground (escopo https://www.googleapis.com/auth/adwords).
# O nível de acesso (Explorer/Básico) é do projeto Cloud; developer token não é mais exigido.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Conta de anúncios (TUZINHO ACADEMY), só dígitos
GOOGLE_ADS_CUSTOMER_ID=2984411839
# MCC que administra a conta (cabeçalho login-customer-id), só dígitos
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9140651596

# ── n8n webhooks (só geração de relatório/boletim via IA — não guardam dado) ──
N8N_WEBHOOK_URL=https://n8n.tuzinho.app/webhook/relatorio-campanhas
# Opcional: webhook separado para o boletim (senão usa N8N_WEBHOOK_URL)
# N8N_DIGEST_WEBHOOK_URL=https://n8n.tuzinho.app/webhook/digest-dash
# Aprovação de cadastro pelo Telegram (sem n8n): usa TELEGRAM_BOT_TOKEN e TELEGRAM_CHAT_ID dos alertas e este segredo,
# que o Telegram devolve a cada clique (veja server/aprovacaoTelegram.js). Texto aleatório de 32+ letras e números.
TELEGRAM_WEBHOOK_SECRET=
# Envia o link de "esqueci minha senha" (o workflow no n8n manda por e-mail/WhatsApp)
N8N_RESET_PASSWORD_WEBHOOK_URL=https://n8n.tuzinho.app/webhook/reset-senha

# URL pública do app, usada para montar o link de redefinição de senha.
# Sem isso, o server usa o header Host da requisição (funciona, mas prefira fixar em produção).
APP_URL=https://dash.tuzinho.academy

# Sincronização dos leads do site (projeto Supabase "Dados Essentials") para a tabela leads do dash.
# O servidor copia sozinho a cada LEADS_SYNC_MINUTES (padrão 10); LEADS_SYNC_ENABLED=false desliga.
# Na mão: node --env-file=.env server/scripts/syncLeadsEssentials.js [--dry]
# Use um usuário só de leitura (ver DEPLOY.md, seção "Leads do site").
# ESSENTIALS_DATABASE_URL=postgresql://dash_leitura.[ref]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# LEADS_SYNC_MINUTES=10
# LEADS_SYNC_ENABLED=true

# ── Banco de dados (Supabase/Postgres) ──
# Login/registro (users) e compras (purchases) vivem aqui — ver db/schema.sql.
# Use a porta 5432 (conexão direta), não a 6543 (pooler), pois o servidor é
# um processo Node persistente, não serverless.
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-xxxx.pooler.supabase.com:5432/postgres

# ── Digest automático (10h e 17h, America/Sao_Paulo) ──
DIGEST_SCHEDULER_ENABLED=true
DIGEST_HOURS=10,17
# Contas do boletim (separadas por vírgula)
DIGEST_ACCOUNT_IDS=act_328274720105539,act_115097955921855,act_630972797908360,act_1197249103808364
# Secret para chamar /api/digest e /api/digest/run (cron Plesk / testes)
DIGEST_CRON_SECRET=troque-por-uma-chave-forte

# ── Webhook de cancelamento de assinatura (Hotmart) ──
# Cadastre em Hotmart → Ferramentas → Webhook → aponte para
# https://SEU-DOMINIO/api/hotmart/webhook e copie o Hottok em Autenticação.
HOTMART_HOTTOK=troque-pelo-hottok-da-hotmart

# ── API Hotmart (histórico de vendas, usado pelos scripts de backfill) ──
# Gere em Hotmart → Ferramentas → Credenciais → Criar credencial → API Hotmart.
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=

# ── Live do Essentials (tela /live) ──
# Caminho ABSOLUTO do arquivo-interruptor no site principal. Existindo, o Apache
# mostra a página da Live em /produtos/essentials/. O app só cria/apaga ESTE
# arquivo. Confirme o caminho real no Plesk (rode `run live:check`).
LIVE_FLAG_PATH=/var/www/vhosts/tuzinho.academy/httpdocs/public/produtos/essentials/live.on
# Teto de emergência da ligação manual, em horas (padrão 6): usado quando não se informa a
# hora de desligar e como limite máximo a partir de agora.
LIVE_MAX_HOURS=6

# ── Servidor de produção ──
PORT=4173
NODE_ENV=production

# ── Liberação de acesso pelo dash (server/acesso — ver DEPLOY.md) ──
# desligado (padrão: o n8n segue responsável) | teste (grava e simula) | ativo
# ACESSO_MODO=teste
# Dia do atraso em que o acesso do Pix parcelado é bloqueado (2 = segundo dia)
# ACESSO_BLOQUEIO_DIA=2
# Plataforma de cursos (Telway)
# TELWAY_LIBERAR_URL=https://gestao.tuzinho.academy/api/liberar-curso
# TELWAY_TOKEN=
# TELWAY_BLOQUEAR_URL=
# E-mail (Brevo) — remetente precisa estar verificado na Brevo
# BREVO_API_KEY=
# BREVO_REMETENTE_EMAIL=nao-responda@tuzinho.academy
# BREVO_REMETENTE_NOME=Tuzinho Academy
# WhatsApp (Evolution API): uma instância fala com o aluno, outra avisa a equipe
# EVOLUTION_URL=https://evo01.tuzinho.academy
# EVOLUTION_ALUNO_INSTANCIA=
# EVOLUTION_ALUNO_APIKEY=
# EVOLUTION_EQUIPE_INSTANCIA=
# EVOLUTION_EQUIPE_APIKEY=
# ACESSO_AVISO_NUMERO=55119XXXXXXXX

# API V2 da plataforma (Telway): bloqueio, reativação e reembolso automáticos
# TELWAY_V2_TOKEN=
# TELWAY_V2_URL=https://gestao.tuzinho.academy/api/v2
# TELWAY_V2_CURSO_ID=21
