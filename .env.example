# ── Meta Marketing API (servidor apenas — nunca expor no frontend) ──
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# ── n8n webhooks (só geração de relatório/boletim via IA — não guardam dado) ──
N8N_WEBHOOK_URL=https://n8n.tuzinho.app/webhook/relatorio-campanhas
# Opcional: webhook separado para o boletim (senão usa N8N_WEBHOOK_URL)
# N8N_DIGEST_WEBHOOK_URL=https://n8n.tuzinho.app/webhook/digest-dash

# ── Banco de dados (Supabase/Postgres) ──
# Login/registro (users) e compras (purchases) vivem aqui — ver db/schema.sql.
# Use a porta 5432 (conexão direta), não a 6543 (pooler), pois o servidor é
# um processo Node persistente, não serverless.
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-xxxx.pooler.supabase.com:5432/postgres

# ── Digest automático (10h e 17h, America/Sao_Paulo) ──
DIGEST_SCHEDULER_ENABLED=true
DIGEST_HOURS=10,17
# Contas do boletim (separadas por vírgula)
DIGEST_ACCOUNT_IDS=act_328274720105539,act_115097955921855,act_630972797908360
# Secret para chamar /api/digest e /api/digest/run (cron Plesk / testes)
DIGEST_CRON_SECRET=troque-por-uma-chave-forte

# ── Servidor de produção ──
PORT=4173
NODE_ENV=production
